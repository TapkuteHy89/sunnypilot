Import('env', 'arch', 'messaging', 'common', 'visionipc')

libs = [common, messaging, visionipc]

if arch != "Darwin":
  # Mi 8 direct Qualcomm CSL/IFE path. Build this device-specific target
  # against the current cereal/VisionIPC ABI; keep the upstream name as an
  # alias so manager and standard build tooling continue to find camerad.
  mi8_env = env.Clone()
  mi8_env['CXX'] = '/usr/bin/clang++'
  mi8_env.Append(CXXFLAGS=['-std=gnu++20'])
  camera_obj = mi8_env.Object(['cameras/camera_qcom2.cc', 'cameras/camera_common.cc', 'cameras/spectra.cc',
                               'cameras/cdm.cc', 'sensors/imx363.cc', 'sensors/s5k3m3.cc'])
  camerad_mi8 = mi8_env.Program('camerad_mi8', ['main.cc', camera_obj], LIBS=libs)
  Alias('camerad', camerad_mi8)
